<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Send0xx.Dispatcher.DependencyInjection.Extensions</PackageId>
    <Title>Dispatcher typed dependency injection extensions</Title>
    <Description>Typed, reflection-free Microsoft dependency injection registrations for the Dispatcher CQRS library.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dispatcher.Abstractions/Dispatcher.Abstractions.csproj" />
    <ProjectReference Include="../Dispatcher/Dispatcher.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
