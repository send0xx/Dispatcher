<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Send0xx.Dispatcher.DependencyInjection</PackageId>
    <Title>Dispatcher dependency injection integration</Title>
    <Description>Reflection-based Microsoft DI Dispatcher implementation with handler scanning, frozen routing, pipelines, and telemetry.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dispatcher/Dispatcher.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Dispatcher.DependencyInjection.Tests"/>
  </ItemGroup>
</Project>